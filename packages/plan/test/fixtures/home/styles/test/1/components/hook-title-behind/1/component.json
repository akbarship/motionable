        "at": {
          "type": "anchor",
          "default": "cut:0",
          "label": {
            "uz": "Vaqt",
            "en": "Time"
          }
        }
      }
    },
    "right": {
      "type": "object",
      "default": {
        "text": "",
        "at": "cut:0"
      },
      "label": {
        "uz": "O\u02bbng so\u02bbz",
