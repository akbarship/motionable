{
  "name": "hook-title-behind",
  "version": 1,
  "kind": "overlay",
  "title": {
    "uz": "Boshdan chiquvchi sarlavha",
    "en": "Title behind the speaker"
  },
  "description": "A big condensed title rises from behind the speaker's head on the scene plane, with two small words under its outer edges that appear as they're spoken. Use with depth behind-subject and attach scene. DEPRECATED 2026-10-19: no text behind the speaker; use hook-title@1 in front.",
