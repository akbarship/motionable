{
  "schema": "motionable.style/1",
  "name": "test",
  "version": 1,
  "title": {
    "en": "Test style (fixture only)"
  },
  "description": "Test fixture: neutral greys, rules kept for the tests.",
  "tags": [
    "talking-head",
    "sales",
    "warm",
    "kinetic"
  ],
  "fits": {
    "footage": [
      "talking-head"
    ],
    "framing": [
      "wide",
      "medium"
    ],
    "lengthS": [
      20,
      90
    ],
    "speakers": 1
  },
  "canvas": {
    "w": 1080,
    "h": 1920,
    "fps": 30
  },
  "madeFrom": {
    "kind": "job",
    "job": "sample-1",
    "note": "approved Motionable edit, Studio v17 (2026-10-06)"
  },
  "author": {
    "kind": "us"
  },
  "owner": null,
  "status": "public",
  "tokens": {
    "color": {
      "text": "#808080",
      "accent": "#808080",
      "strike": "#808080"
    },
    "gradient": {
      "hero": {
        "angle": 180,
        "stops": [
          [
            "#808080",
            0
          ],
          [
            "#808080",
            0.55
          ],
          [
            "#808080",
            1
          ]
        ]
      },
      "title": {
        "angle": 180,
        "stops": [
          [
            "#808080",
            0
          ],
          [
            "#808080",
            0.3
          ],
          [
            "#808080",
            0.62
          ],
          [
            "#808080",
            1
          ]
        ]
      }
    },
    "type": {
      "cap": {
        "font": "Onest",
        "weight": 600,
        "size": 60,
        "shadow": "$shadow.text"
      },
      "accent": {
        "font": "Montserrat",
        "weight": 800,
        "size": 100,
        "fill": "$gradient.hero",
        "keep": true,
        "shadow": "$shadow.text"
      },
      "hero": {
        "font": "Montserrat",
        "weight": 800,
        "size": 150,
        "fill": "$gradient.hero",
        "keep": true,
        "tracking": -3,
        "shadow": "$shadow.text"
      },
      "display": {
        "font": "Bebas Neue",
        "weight": 400,
        "size": 120,
        "caps": true,
        "tracking": 2,
        "shadow": "$shadow.display"
      },
      "title": {
        "font": "Bebas Neue",
        "weight": 400,
        "size": 236,
        "fill": "$gradient.title",
        "tracking": 3
      }
    },
    "framing": {
      "W": {
        "zoom": [
          1.12,
          1.16
        ],
        "face": [
          0.5,
          0.3
        ]
      },
      "M": {
        "zoom": [
          1.3,
          1.35
        ],
        "face": [
          0.5,
          0.27
        ]
      },
      "C": {
        "zoom": [
          1.36,
          1.42
        ],
        "face": [
          0.5,
          0.25
        ]
      }
    },
    "captionZone": {
      "W": 1060,
      "M": 1130,
      "C": 1180,
      "broll": 1180
    },
    "grade": {
      "base": {
        "contrast": 1.08,
        "saturation": 0.9,
        "brightness": 0.97
      },
      "broll": {
        "contrast": 1.05,
        "saturation": 0.92,
        "brightness": 0.95
      },
      "mono-dark": {
        "contrast": 1.15,
        "saturation": 0.2,
        "brightness": 0.68
      }
    },
    "shadow": {
      "text": {
        "y": 2,
        "blur": 12,
        "color": "#808080",
        "opacity": 0.45
      },
      "display": {
        "y": 4,
        "blur": 24,
        "color": "#808080",
        "opacity": 0.35
      }
    },
    "timing": {
      "anchorLead": 0.05,
      "captionLead": "2f",
      "minHold": 0.7
    }
  },
  "rules": {
    "timeline": {
      "trimPausesOver": 0.25,
      "trimTo": 0.1,
      "naturalPause": {
        "afterSentence": 0.36,
        "afterComma": 0.24
      },
      "tail": 0.3,
      "crossfade": 0.04,
      "retakes": "auto-when-sure",
      "filler": "suggest"
    },
    "framing": {
      "levels": [
        "W",
        "M",
        "C"
      ],
      "changeOn": "sentence",
      "hideTrimsWithLevelChange": true,
      "maxSourceUpscale": 1.35,
      "noJumpCutInSentence": true
    },
    "shots": {
      "targetS": [
        4,
        6
      ],
      "maxS": 8
    },
    "hook": {
      "spanS": [
        0,
        2.5
      ],
      "opening": {
        "level": "W",
        "intro": {
          "zoom": 1.45,
          "dur": "26f"
        }
      },
      "structure": "the problem or promise in the first line; title behind the speaker; the spoken key phrase in front"
    },
    "captions": {
      "wordsPerLine": [
        2,
        4
      ],
      "maxLines": 2,
      "lowConfidence": 0.6
    },
    "broll": {
      "shareOfRuntime": [
        0.25,
        0.35
      ],
      "clipS": [
        2,
        4
      ],
      "source": "stock",
      "gradeToFootage": true,
      "captionShade": true,
      "cropLogos": true
    },
    "sound": {
      "music": "none",
      "loudness": -14
    },
    "ending": {
      "ctaLastS": 4,
      "level": "W"
    }
  },
  "triggers": [
    {
      "id": "words",
      "when": "every kept word",
      "do": {
        "captions": "default"
      }
    },
    {
      "id": "hero",
      "when": "emphasis.strength >= 3",
      "do": {
        "captionRole": "hero"
      },
      "max": {
        "per": 6,
        "unit": "s"
      },
      "minGapS": 3
    },
    {
      "id": "number",
      "when": "numbers",
      "do": {
        "captionRole": "hero"
      },
      "countsAs": "hero"
    },
    {
      "id": "list",
      "when": "lists",
      "do": {
        "overlay": "set-hud",
        "captionComponent": "bounce-captions"
      },
      "max": {
        "perVideo": 1
      }
    },
    {
      "id": "topic",
      "when": "beat change",
      "do": {
        "transition": "blur-zoom"
      },
      "max": {
        "perVideo": 3
      }
    },
    {
      "id": "hook",
      "when": "hook",
      "do": {
        "overlay": "hook-title-behind",
        "captionRole": "display"
      }
    },
    {
      "id": "cutaway",
      "when": "brollIdeas",
      "do": {
        "shot": "broll"
      }
    },
    {
      "id": "cta",
      "when": "beat cta | last 4 s",
      "do": {
        "captionRole": "hero"
      },
      "max": {
        "perVideo": 1
      }
    }
  ],
  "components": {
    "captions": {
      "component": "kinetic-captions@1",
      "props": {
        "maxLines": 2
      }
    },
    "captionAlts": [
      "bounce-captions@1",
      "punch-captions@1",
      "highlight-captions@1"
    ],
    "hook": {
      "component": "hook-title-behind@1",
      "props": {}
    },
    "list": {
      "component": "set-hud@1",
      "props": {}
    },
    "listWords": {
      "component": "bounce-captions@1",
      "props": {}
    },
    "topic": {
      "component": "blur-zoom@1",
      "props": {
        "strength": 0.12
      }
    }
  },
  "never": [
    {
      "id": "text-on-face",
      "text": "No text on the face.",
      "check": "face-overlap"
    },
    {
      "id": "two-heroes",
      "text": "No two hero moments within 3 s.",
      "check": "hero-gap"
    },
    {
      "id": "pre-show",
      "text": "Never show words before they're spoken.",
      "check": "caption-timing"
    },
    {
      "id": "hero-hold",
      "text": "Hero words hold at least 0.7 s; don't cut on the word after a hero.",
      "check": "hero-hold"
    },
    {
      "id": "caption-box",
      "text": "No text box behind captions."
    },
    {
      "id": "slide-cards",
      "text": "Nothing that looks like a slide or card template sitting on the footage."
    },
    {
      "id": "flat-accent-title",
      "text": "Accent titles use a rich gradient, not a flat color."
    },
    {
      "id": "static-crop",
      "text": "Never a static crop on a wide shot; always the tracked camera."
    }
  ]
}
